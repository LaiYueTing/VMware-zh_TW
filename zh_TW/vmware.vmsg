msg.gvmomixx.error.invalidResponse.sslConnect = "無法與伺服器建立安全連線"
msg.gvmomixx.error.invalidResponse.timeout = "未收到伺服器回應"
msg.gvmomixx.error.invalidResponse.tooManyRedirects = "嘗試解析要求時重新導向的次數太多"
msg.gvmomixx.error.invalidResponse.transfer = "無法保持到伺服器的連線；請檢查您的網路連線"
msg.gvmomixx.error.invalidResponse.unsupportedProtocol = "指定的通訊協定無效"
msg.gvmomixx.error.invalidResponse.urlMalformat = "提供的 URL 無效"
msg.hbaHosted.conflict = "無法設定類型為 %2$s 的虛擬裝置「%1$s」。為該虛擬裝置指定的 SCSI ID 是為虛擬 SCSI 介面卡保留的。請將該虛擬裝置移到未使用的 SCSI ID，然後重試。|0A"
msg.hbaHosted.invalidDeviceType = "SCSI 裝置類型「%1$s」無效。|0A"
msg.hbaHosted.rawDisk = "您使用的是 SCSI 實體磁碟。SCSI 實體磁碟的雙重開機效能不高。所安裝的作業系統在虛擬機器中可能無法正常開機。但是，如果只在虛擬機器內使用，SCSI 實體磁碟就能正常執行。|0A"
msg.hbacommon.corruptredo = "「%1$s」的重做記錄已損毀。如果問題仍然存在，請放棄該重做記錄。|0A"
msg.hbacommon.hotremove.badadapter = "要求的儲存介面卡無效。"
msg.hbacommon.hotremove.badtarget = "要求的目標編號無效。"
msg.hbacommon.hotremove.failed = "熱移除失敗。"
msg.hbacommon.hotremove.inprogress = "正在執行熱移除。"
msg.hbacommon.hotremove.noadapter = "不存在儲存介面卡。"
msg.hbacommon.hotremove.notarget = "儲存裝置不存在。"
msg.hbacommon.locklost = "用於保護「%1$s」的鎖定已遺失，可能是因為出現了基本儲存問題。|0A如果該虛擬機器設定為高度可用，請確認該虛擬機器在某個其他主機上執行，然後再按一下「確定」。|0A"
msg.hbacommon.outofspace = "虛擬磁碟「%1$s」沒有更多空間。您可以透過以下方法繼續執行該工作階段：釋放相關磁碟區上的磁碟空間，然後按一下「%2$s」。按一下「%3$s」將停止該工作階段。|0A"
msg.hbacommon.unknownDisk = "<>"
msg.hostWin32.affinityFailed = "無法將此 %1$s 處理程序指定給所需處理器 (%2$d)。將使用全部處理器。|0A"
msg.hostWin32.noLegalProcessors = "您已經指定不為該虛擬機器提供處理器。您的處理器設定將被忽略，並將使用全部處理器。|0A"
msg.hostonly.badservice = "似乎未安裝僅主機支援。在開啟服務 %2$s 時，服務控制管理員報告「%1$s」錯誤。是否已透過網路控制台安裝僅主機網路介面卡？|0A"
msg.hostonly.noscm = "警告：無法連線服務控制管理員來驗證僅主機模式介面卡支援是否執行。假定所有功能都可以正常執行。|0A"
msg.hostonly.noservice = "僅主機模式支援似乎未安裝。服務控制管理員報告服務 %1$s 不存在。您是否透過網路控制台安裝了僅主機模式網路介面卡？|0A"
msg.hostonly.servicedown = "僅主機模式介面卡驅動程式似乎未執行。如果您在安裝了僅主機模式網路介面卡後尚未重新啟動主機，則需要先重新啟動主機，然後才能使用此支援。否則，請檢視系統「事件記錄」，了解服務 %1$s 無法正常啟動的原因。|0A"
msg.hostw32.wrongNTversion = "您正在執行的 Windows 版本為 %1$d，該版本的主機作業系統不受支援。|0A本產品僅支援 Windows 8、Windows 8.1、Windows 10、Windows Server 2012、Windows Server 2016 和 Windows Server 2019。|0A"
msg.hotPlug.batchInProgress = "無法開始新的熱插拔批次處理作業，因為另一個批次處理作業已處於活動狀態。"
msg.hotPlug.fail = "熱插拔作業失敗。請檢查虛擬機器記錄以尋找問題線索。"
msg.hotPlug.invalidBatchID = "熱插拔批次處理識別碼無效。"
msg.hotPlug.mismatchBatchID = "熱插拔批次處理識別碼與活動的批次處理不符合。"
msg.hotPlug.startFailed = "無法開始新的熱插拔批次處理作業：%1$d"
