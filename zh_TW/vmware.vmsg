msg.hvuser.NoSVM = "此主機不支援 AMD-V。"
msg.hvuser.NoVT = "此主機不支援 Intel VT-x。"
msg.hvuser.SVMConfig = "此虛擬機器設定不支援 AMD-V 作業。"
msg.hvuser.SVMDisabled = "此主機支援 AMD-V，但 AMD-V 處於停用狀態。|0A如果已在 BIOS/韌體設定中停用 AMD-V，或主機自變更此設定後從未重新啟動，則 AMD-V 可能被停用。|0A (1) 確認 BIOS/韌體設定中啟用了 AMD-V。|0A (2) 如果此 BIOS/韌體設定已變更，請重新啟動主機。|0A (3) 如果您在安裝 %1$s 之後從未重新啟動主機，請重新啟動。|0A (4) 將主機的 BIOS/韌體更新至最新版本。"
msg.hvuser.SVMUnsupported = "此主機支援 AMD-V，但 AMD-V 實施與 %1$s 不相容。"
msg.hvuser.VTConfig = "此虛擬機器設定不支援 Intel VT-x 作業。"
msg.hvuser.VTDisabled = "此主機支援 Intel VT-x，但 Intel VT-x 處於停用狀態。|0A如果已在 BIOS/韌體設定中停用 Intel VT-x，或主機自變更此設定後從未重新啟動，則 Intel VT-x 可能被停用。|0A (1) 確認 BIOS/韌體設定中啟用了 Intel VT-x 並停用了「信賴執行」。|0A (2) 如果這兩項 BIOS/韌體設定有一項已變更，請重新啟動主機。|0A (3) 如果您在安裝 %1$s 之後從未重新啟動主機，請重新啟動。|0A (4) 將主機的 BIOS/韌體更新至最新版本。"
msg.hvuser.VTRestricted = "此主機支援 Intel VT-x，但 Intel VT-x 處於受限狀態。|0A如果已在 BIOS/韌體設定中啟用「信賴執行」，或主機自變更此設定後從未重新啟動，則 Intel VT-x 可能被限制。|0A (1) 確認 BIOS/韌體設定中啟用了 Intel VT-x 並停用了「信賴執行」。|0A (2) 如果這兩項 BIOS/韌體設定有一項已變更，請重新啟動主機。|0A (3) 如果您在安裝 %1$s 之後從未重新啟動主機，請重新啟動。|0A (4) 將主機的 BIOS/韌體更新至最新版本。"
msg.hvuser.VTUnlocked = "此主機支援 Intel VT-x，但 Intel VT-x 處於未鎖定狀態。|0ABIOS/韌體可能需要更新。|0A (1) 確認 BIOS/韌體設定中啟用了 Intel VT-x 並停用了「信賴執行」。|0A (2) 如果這兩項 BIOS/韌體設定有一項已變更，請重新啟動主機。|0A (3) 如果您在安裝 %1$s 之後從未重新啟動主機，請重新啟動。|0A (4) 將主機的 BIOS/韌體更新至最新版本。"
