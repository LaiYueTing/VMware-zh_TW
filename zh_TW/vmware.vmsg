msg.guestOperations.data = "vix 資料 = (%1$s)。"
msg.guestOperations.error = "vix 錯誤碼 = (%1$u, %2$u)。"
msg.guestVarCtl.cfgLimitExceeded = "GuestVariable 存取控制設定已超過上限 (%1$u)。"
msg.guestos.backward = "建立該設定所用的 %1$s 軟體版本中，客體作業系統設定僅供參考。在此版本中，該設定是保證效能和正確設定所必須的。|0A該設定會將變數「hint.guestOS」定義為「%2$s」。請確認此值會反映您正在執行的客體作業系統。|0A選擇「%3$s」可升級設定檔。稍後，您需要儲存該檔案。|0A選擇「%4$s」可繼續，但不升級。|0A"
msg.guestos.badArch = "無法開啟此虛擬機器的電源，因為此虛擬機器需要使用 %1$s 電腦架構，而該架構與此 %2$s 電腦架構主機不相容。請參見知識庫文章 84273。|0A"
msg.guestos.badname = "不支援客體作業系統「%1$s」。|0A請從「虛擬機器設定」中「%3$s」索引標籤上的「%2$s」頁面選擇一個客體作業系統。|0A"
msg.guestos.bootcamp = "這是您首次將 Boot Camp 分割區與 %1$s 結合使用。|0A首次使用時，Microsoft Windows 可能需要一分鐘時間來發現滑鼠及其他虛擬硬體。|0A|0A在某些系統上，初始開機時可能會偵測不到滑鼠。要啟用滑鼠，請關閉虛擬機器並重新啟動。|0A|0A系統可能會要求您重新啟用 Windows。要取得最佳結果，請在重新啟用之前，先安裝 %2$s。|0A|0A要安裝 %3$s，請等待 Windows 完成開機，然後選擇「%4$s」>「%5$s」，然後按照說明進行作業。|0A"
msg.guestos.noname = "設定檔未指定客體作業系統。|0A請從「虛擬機器設定」的「%2$s」索引標籤中的「%1$s」頁面選擇一個客體作業系統。|0A"
msg.gui.cannotReconnect = "無法連線到該裝置。此虛擬機器已將 %1$s 設定為用戶端裝置。請手動重新連線該裝置。|0A"
msg.gui.cannotchangedir = "無法將目錄變更為 %1$s：%2$s|0A"
msg.gui.noTools = "沒有任何 %1$s 套件可用。此客體作業系統無法使用 %2$s 套件。|0A"
msg.gui.noToolsForOther = "沒有任何 %1$s 套件可用。客體作業系統「%3$s」無法使用 %2$s 套件。請檢查「虛擬機器設定」，確認清單中包含正在執行的客體作業系統。|0A"
msg.gui.toolsNoDevice = "此虛擬機器尚未設定 %1$s 磁碟機。虛擬機器必須設定 %2$s 磁碟機，此選項才能起作用。|0A"
msg.gvmomi.cnx.noTicket = "無法取得複製憑證"
msg.gvmomixx.error.generic = "出現無法解釋的錯誤"
msg.gvmomixx.error.invalidResponse.code = "HTTP 錯誤 %1$ld"
msg.gvmomixx.error.invalidResponse.connect = "無法建立與伺服器的連線"
msg.gvmomixx.error.invalidResponse.generic = "連線錯誤"
